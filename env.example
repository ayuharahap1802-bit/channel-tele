# Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_bot

# Super Admin IDs (comma-separated)
SUPER_ADMIN_IDS=123456789,987654321

# Channel/Group IDs for auto post (comma-separated)
AUTO_POST_CHANNELS=-1001234567890,-1009876543210

# Welcome Channels (comma-separated)
WELCOME_CHANNELS=-1001234567890

# Feature Flags
FEATURE_AUTO_WELCOME=true
FEATURE_AUTO_POST=true
FEATURE_BROADCAST=true
FEATURE_USER_TRACKING=true
FEATURE_MULTI_LANGUAGE=true

# Bot Settings
DEFAULT_LANGUAGE=id
